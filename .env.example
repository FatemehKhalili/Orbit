# Orbit development environment for Docker Compose.
# Create .env with ./scripts/setup-env.sh (generates a random password), or copy this
# file to .env and fill in the blanks. Never commit .env.

ORBIT_ENV=development

# PostgreSQL. POSTGRES_PASSWORD is required and has no default.
# Use only URL-safe characters (letters, digits, - _ . ~); it is embedded in DATABASE_URL.
POSTGRES_USER=orbit
POSTGRES_PASSWORD=
POSTGRES_DB=orbit

# The timezone that decides which calendar day is "today", for example Europe/Berlin.
# An IANA name; the API refuses to start with an unknown one. Defaults to UTC.
# ORBIT_TIMEZONE=UTC

# Sign-in throttling (ADR 0010). The defaults suit almost everyone.
# ORBIT_LOGIN_FREE_ATTEMPTS=5
# ORBIT_LOGIN_GLOBAL_FREE_ATTEMPTS=100
# ORBIT_LOGIN_BLOCK_SECONDS=30
# ORBIT_LOGIN_MAX_BLOCK_SECONDS=900

# Production setup only (compose.production.yml, docs/deployment/README.md). It always
# runs with ORBIT_ENV=production; ORBIT_ENV above is for the development setup.
# Optional HTTPS proxy (`--profile https`): the name devices use, where the certificate
# comes from (internal: Caddy's local authority; acme: a public one), where it listens.
# ORBIT_DOMAIN=orbit.home.arpa
# ORBIT_TLS=internal
# ORBIT_HTTPS_BIND=127.0.0.1
# Set to true with the https profile (or a proxy that sets X-Forwarded-For), never
# when browsers reach the web app directly.
# ORBIT_TRUSTED_PROXY=false

# Host ports. Services bind to 127.0.0.1 only.
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
