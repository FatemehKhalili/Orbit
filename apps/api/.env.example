# Only needed when running the API outside Docker Compose.
# Copy to apps/api/.env (git-ignored) and fill in. Real environment variables win over this file.

ORBIT_ENV=development

# PostgreSQL connection. Use the password you set in the root .env.
DATABASE_URL=postgresql://orbit:YOUR_PASSWORD@localhost:5432/orbit

# How long a sign-in lasts, in days (1-365).
# ORBIT_SESSION_TTL_DAYS=30
