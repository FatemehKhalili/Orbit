# Only needed when running the web app outside Docker Compose.
# Copy to apps/web/.env.local (git-ignored). Read at request time on the server.

# Where the Next.js server reaches the Orbit API.
ORBIT_API_URL=http://localhost:8000

# Session cookies are Secure (HTTPS only) when NODE_ENV=production. Set this to true only
# to run a production build over plain HTTP on a trusted home network.
# ORBIT_INSECURE_COOKIES=true

# Only behind a reverse proxy that sets X-Forwarded-For: pass the browser's address on
# to the API's sign-in throttle.
# ORBIT_TRUSTED_PROXY=true
